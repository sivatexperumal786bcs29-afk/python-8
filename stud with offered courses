import sys
import gc
class University:
    def __init__(self, university_name):
        self.university_name = university_name
        self.student_list = []
    def add_student(self, rollno, name):
        new_student = self.Students(rollno, name, self)
        self.student_list.append(new_student)
        print(f"Success: Student '{name}' added to {self.university_name}.")
    def remove_student(self, rollno):
        for s in self.student_list:
            if s.rollno == rollno:
                print(f"Removing Student: {s.name} (Roll No: {s.rollno})")
                self.student_list.remove(s)
                return
        print("Error: Student Roll No not found.")
    def display_all(self):
        print(f"\n--- Enrollment List for {self.university_name} ---")
        if not self.student_list:
            print("No students currently enrolled.")
        for s in self.student_list:
            s.display_details()
    class Students:
        def __init__(self, rollno, name, university_obj):
            self.rollno = rollno
            self.name = name
            self.university = university_obj
        def display_details(self):
            print(f"Roll No: {self.rollno} | Name: {self.name} | Uni: {self.university.university_name}")
        def __del__(self):
            """Destructor to monitor Garbage Collection."""
            print(f"[GC] Memory released for student object: {self.name}")
def main():
    u_name = input("Enter University Name: ")
    my_uni = University(u_name)
    try:
        n = int(input("How many students do you want to add? "))
    except ValueError:
        print("Invalid input. Please enter a number.")
        return
    for i in range(n):
        print(f"\nDetails for Student {i + 1}:")
        r = input("Enter Roll No: ")
        nm = input("Enter Name: ")
        my_uni.add_student(r, nm)
    print("\n" + "=" * 40)
    print("OBSERVING REFERENCE COUNTS")
    print(f"University object references: {sys.getrefcount(my_uni)}")
    if my_uni.student_list:
        print(f"Student list references: {sys.getrefcount(my_uni.student_list)}")
    print("=" * 40)
    my_uni.display_all()
    if n > 0:
        rem_roll = input("\nEnter a Roll No to remove (simulate out of scope): ")
        my_uni.remove_student(rem_roll)
        print("\nTriggering Garbage Collector manually...")
        gc.collect()
    my_uni.display_all()
if __name__ == "__main__":
    main()
